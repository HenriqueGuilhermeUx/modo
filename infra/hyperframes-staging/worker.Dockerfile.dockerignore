# Dockerfile-specific ignore, avoids changing MODO's production build contexts.
.git
.gitignore
.github
**/node_modules
**/dist
**/.next
**/.expo
**/coverage
**/test-results
**/.env
**/.env.*
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/*.crt
**/*.sqlite
**/*.sqlite3
**/*.db
**/private
**/.private
**/secrets
**/.secrets
**/private-order.json
**/order.json
**/synthetic.mp4
**/result.json
