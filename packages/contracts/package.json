    "./payment": {"types": "./src/payment.ts", "import": "./dist/payment.js"},
    "./linkedin": {"types": "./src/linkedin.ts", "import": "./dist/linkedin.js"},
    "./instagram": {"types": "./src/instagram.ts", "import": "./dist/instagram.js"},
    "./postiz": {"types": "./src/postiz.ts", "import": "./dist/postiz.js"},
    "./distribution-quality": {"types": "./src/distribution-quality.ts", "import": "./dist/distribution-quality.js"},
    "./native-publisher": {"types": "./src/native-publisher.ts", "import": "./dist/native-publisher.js"},
